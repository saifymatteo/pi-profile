{
  "name": "@saifymatteo/pi-profile",
  "version": "0.3.0",
  "description": "Prompt-inert runtime profiles for the Pi coding agent — model binding, skill restriction, and UI metadata in the same session, no restart needed.",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-profile",
    "profiles",
    "persona",
    "identity"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saifymatteo/pi-profile.git"
  },
  "homepage": "https://github.com/saifymatteo/pi-profile#readme",
  "bugs": {
    "url": "https://github.com/saifymatteo/pi-profile/issues"
  }
}
